# Токен бота из @BotFather. Без него сервис не запускается.
TELEGRAM_BOT_TOKEN=

# Кому боту разрешено писать и отвечать. Несколько чатов — через запятую.
# Свой номер чата можно узнать у бота @userinfobot.
TELEGRAM_CHAT_IDS=

# Секрет для сервисов, которые присылают события. Придумайте длинную строку.
NOTIFY_SECRET=

# Порт приёма событий и каталог с журналом и открытыми вопросами.
NOTIFY_PORT=8790
NOTIFY_DATA_DIR=/srv/notify/data

# Сколько секунд ждать ответа на вопрос, если не задано иное.
NOTIFY_ANSWER_TIMEOUT=3600

# Доступы префектуры, чтобы кнопки «Утвердить» и «Отклонить» работали.
ODH_API_URL=https://obhod-sao.ru/odh-api
ODH_PREFECTURE_LOGIN=
ODH_PREFECTURE_PASSWORD=

PHOTO_SERVICE_API_URL=https://obhod-sao.ru/photo-api
PHOTO_SERVICE_PREFECTURE_LOGIN=
PHOTO_SERVICE_PREFECTURE_PASSWORD=
