PHOTO_SERVICE_DB_PASSWORD=
PHOTO_SERVICE_HOST_PORT=8788
PHOTO_SERVICE_PORT=8788
PHOTO_SERVICE_MEDIA_ROOT=./media
PHOTO_SERVICE_ALLOWED_ORIGINS=https://hainox.github.io
PHOTO_SERVICE_BASE_PATH=
PHOTO_SERVICE_COOKIE_SECURE=false
PHOTO_SERVICE_COOKIE_PATH=/photo-api
# lax — для локального запуска и same-origin. none — для production, где атлас на GitHub Pages:
# кросс-сайтовый запрос без SameSite=None не отправит сессионную cookie.
PHOTO_SERVICE_COOKIE_SAMESITE=lax
